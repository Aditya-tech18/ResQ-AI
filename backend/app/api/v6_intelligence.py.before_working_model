"""Optional Gemini transcript extraction. No fabricated call or consent."""
import json
import os
import re
import httpx
from fastapi import APIRouter, HTTPException
from pydantic import BaseModel, Field

router = APIRouter(prefix="/api/v6", tags=["ResQ AI extraction"])

class ExtractRequest(BaseModel):
    transcript: str = Field(min_length=10, max_length=4000)
    language: str = Field(pattern="^(hi|en|te)$")

@router.get("/capabilities")
def capabilities():
    return {"gemini_configured": bool(os.getenv("GEMINI_API_KEY")),
            "gnani_outbound_configured": False,
            "real_call_connected": False,
            "note": "Real Gnani calls require verified outbound API schema and credentials."}

@router.post("/extract")
def extract(req: ExtractRequest):
    key = os.getenv("GEMINI_API_KEY", "").strip()
    if not key:
        raise HTTPException(503, "Set GEMINI_API_KEY in your terminal to enable AI extraction")
    model = os.getenv("RESQ_GEMINI_MODEL", "gemini-3.8-flash")
    if not re.fullmatch(r"[a-zA-Z0-9._-]+", model):
        raise HTTPException(400, "Invalid model name")
    prompt = ("Extract only facts explicitly stated by a delivery driver in the transcript. "
              "Do not invent values. Return ONLY a JSON object with keys "
              "eta_minutes (integer or null), parcel_capacity (integer or null), "
              "destination (string or null), accepted (boolean or null). "
              "If the speaker has not clearly accepted, accepted must be null. "
              "Language: " + req.language + "\nTranscript: " + req.transcript)
    try:
        with httpx.Client(timeout=20.0) as client:
            response = client.post(
                f"https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent",
                headers={"x-goog-api-key": key, "Content-Type": "application/json"},
                json={"contents": [{"parts": [{"text": prompt}]}],
                      "generationConfig": {"responseMimeType": "application/json", "temperature": 0}},
            )
            response.raise_for_status()
            text = response.json()["candidates"][0]["content"]["parts"][0]["text"]
            data = json.loads(text)
    except (httpx.HTTPError, ValueError, KeyError, IndexError, TypeError) as exc:
        raise HTTPException(502, "Gemini extraction failed; check API access and model") from exc
    if not isinstance(data, dict):
        raise HTTPException(502, "Invalid Gemini extraction")
    eta = data.get("eta_minutes")
    parcels = data.get("parcel_capacity")
    dest = data.get("destination")
    accepted = data.get("accepted")
    return {"eta_minutes": eta if type(eta) is int and 1 <= eta <= 240 else None,
            "parcel_capacity": parcels if type(parcels) is int and 0 <= parcels <= 100 else None,
            "destination": dest[:160] if isinstance(dest, str) and dest.strip() else None,
            "accepted": accepted if type(accepted) is bool else None,
            "source": "GEMINI_EXTRACTED_FROM_USER_SUPPLIED_TEXT_NOT_VERIFIED_AUDIO"}
