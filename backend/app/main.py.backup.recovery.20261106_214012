# ResQ AI telephony webhook integration.
#
# This must run after the main app is constructed and all existing
# routers are registered. A unique route check prevents duplicates.

import os as _resq_os
from pathlib import Path as _ResQPath

from app.api.telephony_webhooks import (
    router as _resq_telephony_router,
)
from app.services.telephony_event_inbox import (
    TelephonyEventInbox as _ResQInbox,
)
from app.services.telephony_webhook_ingestion import (
    TelephonyWebhookIngestionService as _ResQIngestion,
)

_RESQ_WEBHOOK_PATH = "/api/v1/telephony/webhooks"

def _resq_register_webhook_router():
    existing_paths = {
        getattr(route, "path", None)
        for route in app.routes
    }

    if _RESQ_WEBHOOK_PATH not in existing_paths:
        app.include_router(_resq_telephony_router)

    registered = [
        route
        for route in app.routes
        if getattr(route, "path", None)
        == _RESQ_WEBHOOK_PATH
    ]

    if len(registered) != 1:
        raise RuntimeError(
            "ResQ webhook router registration failed"
        )

    app.state.resq_telephony_router_registered = True

_resq_register_webhook_router()

_resq_secret = _resq_os.getenv("RESQ_WEBHOOK_SECRET")

if _resq_secret:
    _resq_db_path = _ResQPath(
        _resq_os.getenv(
            "RESQ_WEBHOOK_DB_PATH",
            "resq_telephony_inbox.sqlite3",
        )
    )

    app.state.telephony_inbox = _ResQInbox(_resq_db_path)

    app.state.telephony_ingestion_service = _ResQIngestion(
        secret=_resq_secret,
        inbox=app.state.telephony_inbox,
    )
