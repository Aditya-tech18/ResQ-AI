GEMINI_API_KEY=
RESQ_DISPATCHER_TOKEN=
# ============================================================
# DISPATCHRESOLVE AI — ENVIRONMENT CONFIGURATION
# ============================================================
# This file contains placeholders ONLY.
# Copy to .env and fill credentials locally.
# NEVER commit the actual .env file.
# ============================================================

# APPLICATION
APP_NAME="DispatchResolve AI"
APP_VERSION="0.1.0"
APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8000
API_V1_PREFIX=/api/v1

# FRONTEND / CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=false
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# DATABASE
DATABASE_URL=sqlite:///./dispatchresolve.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# AUTHENTICATION
# Generate a strong secret for local development.
# Never use a public example value in production.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=12

# GNANI AI
# Enter credentials from your authorized Gnani console.
# Use actual endpoints from https://docs.gnani.ai
GNANI_API_KEY=
GNANI_STT_API_KEY=
GNANI_TTS_API_KEY=
GNANI_STT_ENDPOINT=
GNANI_TTS_ENDPOINT=
GNANI_STT_MODEL=
GNANI_TTS_MODEL=
GNANI_STT_LANGUAGE=auto
GNANI_TTS_LANGUAGE=hi-IN
GNANI_TTS_VOICE=
GNANI_TIMEOUT_SECONDS=45
GNANI_MAX_RETRIES=2
GNANI_RETRY_BASE_SECONDS=1.0

# AI REASONING
# rules = local deterministic logic
# openai_compatible = configured external reasoning model
AI_REASONING_PROVIDER=rules
AI_API_KEY=
AI_BASE_URL=
AI_MODEL_NAME=
AI_TEMPERATURE=0.0
AI_MAX_OUTPUT_TOKENS=1024
AI_REQUEST_TIMEOUT_SECONDS=30
AI_ENABLE_CASE_SUMMARIES=true
AI_ENABLE_ETA_EXTRACTION=true
AI_ENABLE_ACTION_RECOMMENDATIONS=true
AI_ENABLE_CONTRADICTION_DETECTION=true

# AUDIO SECURITY
MAX_AUDIO_UPLOAD_MB=15
MAX_AUDIO_DURATION_SECONDS=120
STORE_RAW_AUDIO=false

# LOGISTICS WORKFLOW
PICKUP_GRACE_PERIOD_MINUTES=15
SLA_CHECK_INTERVAL_SECONDS=60
MAX_COMMITMENT_REVISIONS=3
ESCALATION_LEVEL_1_MINUTES=15
ESCALATION_LEVEL_2_MINUTES=60
ESCALATION_LEVEL_3_MINUTES=180
REQUIRE_PICKUP_SCAN_FOR_CLOSURE=true
ENABLE_AUTOMATIC_ESCALATION=true
ENABLE_REAL_OUTBOUND_CALLS=false
ENABLE_EXTERNAL_NOTIFICATIONS=false

# DEMO SETTINGS
DEMO_MODE=true
DEMO_SEED_SHIPMENT_COUNT=50
DEMO_ALLOW_TIME_TRAVEL=true
DEMO_ALLOW_SYNTHETIC_PICKUP_SCANS=true

# OBSERVABILITY
LOG_LEVEL=INFO
LOG_JSON=false
ENABLE_REQUEST_LOGGING=true
LOG_SENSITIVE_PAYLOADS=false
ENABLE_METRICS=true
